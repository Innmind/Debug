{
    "name": "innmind/debug",
    "type": "library",
    "description": "Set of tools to help debug applications",
    "keywords": ["debug", "http", "cli"],
    "homepage": "http://github.com/Innmind/Debug",
    "license": "MIT",
    "authors": [
        {
            "name": "Baptiste Langlade",
            "email": "baptiste.langlade@hey.com"
        }
    ],
    "support": {
        "issues": "http://github.com/Innmind/Debug/issues"
    },
    "require": {
        "php": "~8.4",
        "innmind/profiler": "~5.0",
        "innmind/framework": "~4.1",
        "innmind/foundation": "~2.1",
        "innmind/stack-trace": "~5.0",
        "innmind/object-graph": "~3.4"
    },
    "autoload": {
        "psr-4": {
            "Innmind\\Debug\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Innmind\\Debug\\": "tests/"
        }
    },
    "require-dev": {
        "innmind/static-analysis": "~1.3",
        "innmind/black-box": "~6.5",
        "innmind/coding-standard": "~2.0"
    },
    "provide": {
        "innmind/framework-middlewares": "4.0"
    }
}
